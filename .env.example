# Redis compatibility. Configure one complete pair, never a URL from one
# provider with a token from the other.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Spotify. Register http://127.0.0.1:8888/callback, then run
# `node scripts/spotify-setup.mjs` to complete the one-time OAuth flow.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional local-helper switch. Any non-empty value prevents the helper from
# opening a browser automatically.
SPOTIFY_SETUP_NO_OPEN=

# Server-side signing and authorization secrets. Generate independent random
# values for each purpose; do not reuse credentials between capabilities.
CRON_SECRET=
RATE_LIMIT_SECRET=
VOTE_SECRET=

# Resend subscription, notification, and inbound webhook integration.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_FORWARD_TO=
